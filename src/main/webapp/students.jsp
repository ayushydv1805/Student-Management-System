<%@ page import="java.util.*,edu.college.sms.model.Student" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!
private String esc(Object v){if(v==null)return "";return v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#x27;");}
%>
<% List<Student> students=(List<Student>)request.getAttribute("students"); String q=request.getParameter("q"); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Students · CampusDesk</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/app.css"></head><body><aside class="sidebar"><a class="brand" href="<%=request.getContextPath()%>/"><span class="brand-icon">C</span><span>CampusDesk<small>STUDENT SYSTEM</small></span></a><nav><a href="<%=request.getContextPath()%>/">▦ &nbsp; Overview</a><a class="active" href="<%=request.getContextPath()%>/students">♙ &nbsp; Students</a></nav><div class="side-note"><span class="dot"></span> Database project<small>Java · JDBC · MySQL</small></div></aside><main class="main"><header class="topbar"><div><p class="eyebrow">RECORD MANAGEMENT</p><h1>Students</h1><p class="muted">Search and manage your student records.</p></div><a class="button" href="<%=request.getContextPath()%>/student-form.jsp">＋ Add student</a></header>
<% if ("saved".equals(request.getParameter("message")) || "deleted".equals(request.getParameter("message"))) { %><div class="notice">✓ Student record updated successfully.</div><% } %>
<section class="table-panel"><div class="table-toolbar"><div><h2>Student directory</h2><p class="muted"><%=students==null?0:students.size()%> record(s) shown</p></div><form class="search" method="get" action="<%=request.getContextPath()%>/students"><input name="q" value="<%=esc(q)%>" placeholder="Search name, roll no, email…"><button class="button" type="submit">Search</button></form></div>
<div class="table-wrap"><table><thead><tr><th>STUDENT</th><th>ROLL NUMBER</th><th>DEPARTMENT</th><th>SEMESTER</th><th>STATUS</th><th>ACTIONS</th></tr></thead><tbody>
<% if(students!=null) for(Student s:students){ %><tr><td><div class="student-cell"><span class="avatar"><%=esc(s.getFirstName().substring(0,1).toUpperCase())%></span><div><strong><%=esc(s.getFirstName())%> <%=esc(s.getLastName())%></strong><small><%=esc(s.getEmail())%></small></div></div></td><td><%=esc(s.getRollNo())%></td><td><%=esc(s.getDepartmentName()==null?"Unassigned":s.getDepartmentName())%></td><td><%=s.getSemester()%></td><td><span class="pill"><%=esc(s.getStatus())%></span></td><td class="actions"><a href="<%=request.getContextPath()%>/students?action=edit&id=<%=s.getStudentId()%>">Edit</a><a href="<%=request.getContextPath()%>/students?action=view&id=<%=s.getStudentId()%>">View</a><form class="inline-delete" method="post" action="<%=request.getContextPath()%>/students" onsubmit="return confirm('Delete this student record?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=s.getStudentId()%>"><button class="danger-button" type="submit">Delete</button></form></td></tr><% } %>
<% if(students==null||students.isEmpty()){ %><tr><td colspan="6" class="empty">No student records found. Add a student or try another search.</td></tr><% } %>
</tbody></table></div></section><footer>CampusDesk · Student Management System <span>Keep academic records organized</span></footer></main></body></html>