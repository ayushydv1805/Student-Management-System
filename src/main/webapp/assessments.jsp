<%@ page import="java.util.*" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!
private String esc(Object v){if(v==null)return "";return v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#x27;");}
%>
<%List<Map<String,Object>> assessments=(List<Map<String,Object>>)request.getAttribute("assessments");List<Map<String,Object>> courses=(List<Map<String,Object>>)request.getAttribute("courses");String q=request.getParameter("q");%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Assessments · CampusDesk</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/app.css"></head><body><aside class="sidebar"><a class="brand" href="<%=request.getContextPath()%>/"><span class="brand-icon">C</span><span>CampusDesk<small>STUDENT SYSTEM</small></span></a><nav><a href="<%=request.getContextPath()%>/">▦ &nbsp; Overview</a><a href="<%=request.getContextPath()%>/students">♙ &nbsp; Students</a><a href="<%=request.getContextPath()%>/courses">▤ &nbsp; Courses</a><a href="<%=request.getContextPath()%>/enrollments">↗ &nbsp; Enrollments</a><a href="<%=request.getContextPath()%>/attendance">◷ &nbsp; Attendance</a><a class="active" href="<%=request.getContextPath()%>/assessments">✓ &nbsp; Assessments & marks</a><a href="<%=request.getContextPath()%>/performance">▥ &nbsp; Performance</a></nav></aside><main class="main"><header class="topbar"><div><p class="eyebrow">EXAMS AND CONTINUOUS ASSESSMENT</p><h1>Assessments & marks</h1><p class="muted">Create a course assessment, then enter marks for enrolled students.</p></div><a class="button button-secondary" href="<%=request.getContextPath()%>/performance">Performance report →</a></header><%if("saved".equals(request.getParameter("message"))){%><div class="notice">✓ Assessment created successfully.</div><%}%><section class="form-panel" style="margin-bottom:22px"><form method="post" action="<%=request.getContextPath()%>/assessments"><div class="form-section"><h2>Create assessment</h2><p class="muted">Students must be enrolled in the selected course before marks can be recorded.</p><div class="form-grid"><label>Course *<select name="courseId" required><option value="">Choose course</option><%if(courses!=null)for(Map<String,Object> c:courses){%><option value="<%=c.get("id")%>"><%=esc(c.get("code"))%> — <%=esc(c.get("name"))%></option><%}%></select></label><label>Assessment name *<input name="assessmentName" required maxlength="100" placeholder="e.g. MST 1"></label><label>Maximum marks *<input name="maxMarks" type="number" min="0.01" max="9999.99" step="0.01" required placeholder="e.g. 30"></label><label>Assessment date<input name="assessmentDate" type="date"></label></div><div class="form-actions"><button class="button" type="submit">Create assessment →</button></div></div></form></section><section class="table-panel"><div class="table-toolbar"><div><h2>Assessment register</h2><p class="muted"><%=assessments==null?0:assessments.size()%> assessment(s)</p></div><form class="search" method="get" action="<%=request.getContextPath()%>/assessments"><input name="q" value="<%=esc(q)%>" placeholder="Search assessment/course"><button class="button" type="submit">Search</button></form></div><div class="table-wrap"><table><thead><tr><th>ASSESSMENT</th><th>COURSE</th><th>DATE</th><th>MAX MARKS</th><th>MARKS ENTERED</th><th>ACTION</th></tr></thead><tbody><%if(assessments!=null)for(Map<String,Object>a:assessments){%><tr><td><strong><%=esc(a.get("name"))%></strong></td><td><%=esc(a.get("courseCode"))%><br><small><%=esc(a.get("course"))%></small></td><td><%=a.get("date")==null?"—":esc(a.get("date"))%></td><td><%=esc(a.get("max"))%></td><td><%=a.get("entered")%></td><td><a class="button" href="<%=request.getContextPath()%>/assessments?action=marks&id=<%=a.get("id")%>">Enter marks →</a></td></tr><%}%><%if(assessments==null||assessments.isEmpty()){%><tr><td colspan="6" class="empty">No assessments yet. Create one above to begin entering marks.</td></tr><%}%></tbody></table></div></section><footer>CampusDesk · Assessments and marks</footer></main></body></html>
