<%@ page import="java.util.*" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!
private String esc(Object v){if(v==null)return "";return v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#x27;");}
%>
<%List<Map<String,Object>> students=(List<Map<String,Object>>)request.getAttribute("students");List<Map<String,Object>> courses=(List<Map<String,Object>>)request.getAttribute("courses");%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>New enrollment · CampusDesk</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/app.css"></head><body><aside class="sidebar"><a class="brand" href="<%=request.getContextPath()%>/"><span class="brand-icon">C</span><span>CampusDesk<small>STUDENT SYSTEM</small></span></a><nav><a href="<%=request.getContextPath()%>/">▦ &nbsp; Overview</a><a href="<%=request.getContextPath()%>/students">♙ &nbsp; Students</a><a href="<%=request.getContextPath()%>/courses">▤ &nbsp; Courses</a><a class="active" href="<%=request.getContextPath()%>/enrollments">↗ &nbsp; Enrollments</a></nav></aside><main class="main"><header class="topbar"><div><p class="eyebrow">REGISTRATION</p><h1>New enrollment</h1><p class="muted">Choose a student, course, academic year and semester.</p></div><a class="button button-secondary" href="<%=request.getContextPath()%>/enrollments">← Back to enrollments</a></header><section class="form-panel"><%if(students==null||students.isEmpty()||courses==null||courses.isEmpty()){%><div class="empty">To create an enrollment, first add at least one active student and one course.<p><a class="button" href="<%=request.getContextPath()%>/students?action=add">Add student</a> <a class="button button-secondary" href="<%=request.getContextPath()%>/courses?action=add">Add course</a></p></div><%}else{%><form method="post" action="<%=request.getContextPath()%>/enrollments"><div class="form-section"><h2>Enrollment details</h2><p class="muted">The database prevents duplicate enrollments for the same term.</p><div class="form-grid"><label>Student *<select name="studentId" required><option value="">Select student</option><%for(Map<String,Object>s:students){%><option value="<%=s.get("id")%>"><%=esc(s.get("roll"))%> — <%=esc(s.get("name"))%></option><%}%></select></label><label>Course *<select name="courseId" required><option value="">Select course</option><%for(Map<String,Object>c:courses){%><option value="<%=c.get("id")%>"><%=esc(c.get("code"))%> — <%=esc(c.get("name"))%></option><%}%></select></label><label>Academic year *<input name="academicYear" required pattern="20[0-9]{2}-[0-9]{2}" maxlength="7" value="2026-27" placeholder="2026-27"></label><label>Semester *<select name="semester" required><%for(int i=1;i<=12;i++){%><option value="<%=i%>" <%=i==1?"selected":""%>><%=i%></option><%}%></select></label></div></div><div class="form-actions"><a class="button button-secondary" href="<%=request.getContextPath()%>/enrollments">Cancel</a><button class="button" type="submit">Create enrollment →</button></div></form><%}%></section><footer>CampusDesk · Enrollment registration</footer></main></body></html>
