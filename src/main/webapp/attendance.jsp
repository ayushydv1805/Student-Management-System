<%@ page import="java.util.*" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!
private String esc(Object v){if(v==null)return "";return v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#x27;");}
%>
<%List<Map<String,Object>> records=(List<Map<String,Object>>)request.getAttribute("records");String date=(String)request.getAttribute("selectedDate");String q=request.getParameter("q");%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Attendance · CampusDesk</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/app.css"></head><body><aside class="sidebar"><a class="brand" href="<%=request.getContextPath()%>/"><span class="brand-icon">C</span><span>CampusDesk<small>STUDENT SYSTEM</small></span></a><nav><a href="<%=request.getContextPath()%>/">▦ &nbsp; Overview</a><a href="<%=request.getContextPath()%>/students">♙ &nbsp; Students</a><a href="<%=request.getContextPath()%>/courses">▤ &nbsp; Courses</a><a href="<%=request.getContextPath()%>/enrollments">↗ &nbsp; Enrollments</a><a class="active" href="<%=request.getContextPath()%>/attendance">◷ &nbsp; Attendance</a><a href="<%=request.getContextPath()%>/assessments">✓ &nbsp; Assessments & marks</a><a href="<%=request.getContextPath()%>/performance">▥ &nbsp; Performance</a></nav><div class="side-note"><span class="dot"></span> Academic records<small>Java · JDBC · MySQL</small></div></aside><main class="main"><header class="topbar"><div><p class="eyebrow">DAILY CLASS REGISTER</p><h1>Attendance</h1><p class="muted">Choose a date and record each enrolled student's attendance.</p></div><a class="button button-secondary" href="<%=request.getContextPath()%>/performance">View performance →</a></header><%if("saved".equals(request.getParameter("message"))){%><div class="notice">✓ Attendance saved successfully.</div><%}%><section class="table-panel"><div class="table-toolbar"><div><h2>Attendance register</h2><p class="muted"><%=records==null?0:records.size()%> enrolled student-course record(s)</p></div><form class="search" method="get" action="<%=request.getContextPath()%>/attendance"><input type="date" name="date" value="<%=esc(date)%>" required><input name="q" value="<%=esc(q)%>" placeholder="Search student/course"><button class="button" type="submit">View</button></form></div><div class="table-wrap"><table><thead><tr><th>STUDENT</th><th>ROLL NO.</th><th>COURSE</th><th>TERM</th><th>STATUS</th><th>SAVE</th></tr></thead><tbody><%if(records!=null)for(Map<String,Object> r:records){String status=(String)r.get("status");%><tr><td><strong><%=esc(r.get("student"))%></strong></td><td><%=esc(r.get("roll"))%></td><td><strong><%=esc(r.get("courseCode"))%></strong><br><small><%=esc(r.get("course"))%></small></td><td><%=esc(r.get("year"))%> · Sem <%=r.get("semester")%></td><td><form id="att-<%=r.get("enrollmentId")%>" method="post" action="<%=request.getContextPath()%>/attendance"><input type="hidden" name="date" value="<%=esc(date)%>"><input type="hidden" name="enrollmentId" value="<%=r.get("enrollmentId")%>"><select name="status" aria-label="Attendance status" required><%if(status==null){%><option value="" selected disabled>Choose status…</option><%}%><%for(String s:new String[]{"PRESENT","ABSENT","LATE","EXCUSED"}){%><option value="<%=s%>" <%=status!=null&&s.equals(status)?"selected":""%>><%=s%></option><%}%></select></form></td><td><button class="button" type="submit" form="att-<%=r.get("enrollmentId")%>">Save</button></td></tr><%}%><%if(records==null||records.isEmpty()){%><tr><td colspan="6" class="empty">No enrolled students found. Add students and course enrollments first.</td></tr><%}%></tbody></table></div></section><footer>CampusDesk · Attendance register</footer></main></body></html>
