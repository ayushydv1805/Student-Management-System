<%@ page import="java.util.*" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!
private String esc(Object v){if(v==null)return "";return v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#x27;");}
%>
<%List<Map<String,Object>> enrollments=(List<Map<String,Object>>)request.getAttribute("enrollments");String q=request.getParameter("q");%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Enrollments · CampusDesk</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/app.css"></head><body><aside class="sidebar"><a class="brand" href="<%=request.getContextPath()%>/"><span class="brand-icon">C</span><span>CampusDesk<small>STUDENT SYSTEM</small></span></a><nav><a href="<%=request.getContextPath()%>/">▦ &nbsp; Overview</a><a href="<%=request.getContextPath()%>/students">♙ &nbsp; Students</a><a href="<%=request.getContextPath()%>/courses">▤ &nbsp; Courses</a><a class="active" href="<%=request.getContextPath()%>/enrollments">↗ &nbsp; Enrollments</a></nav><div class="side-note"><span class="dot"></span> Database project<small>Java · JDBC · MySQL</small></div></aside><main class="main"><header class="topbar"><div><p class="eyebrow">STUDENT COURSE REGISTRATION</p><h1>Enrollments</h1><p class="muted">Connect students to courses by academic year and semester.</p></div><a class="button" href="<%=request.getContextPath()%>/enrollments?action=add">＋ New enrollment</a></header>
<%if("saved".equals(request.getParameter("message"))||"deleted".equals(request.getParameter("message"))){%><div class="notice">✓ <%= "deleted".equals(request.getParameter("message"))?"Enrollment removed successfully.":"Student enrolled successfully."%></div><%}%>
<section class="table-panel"><div class="table-toolbar"><div><h2>Enrollment register</h2><p class="muted"><%=enrollments==null?0:enrollments.size()%> enrollment(s) shown</p></div><form class="search" method="get" action="<%=request.getContextPath()%>/enrollments"><input name="q" value="<%=esc(q)%>" placeholder="Search student or course…"><button class="button" type="submit">Search</button></form></div><div class="table-wrap"><table><thead><tr><th>STUDENT</th><th>ROLL NUMBER</th><th>COURSE</th><th>ACADEMIC YEAR</th><th>SEMESTER</th><th>ACTIONS</th></tr></thead><tbody>
<%if(enrollments!=null)for(Map<String,Object>e:enrollments){%><tr><td><strong><%=esc(e.get("student"))%></strong></td><td><%=esc(e.get("roll"))%></td><td><strong><%=esc(e.get("courseCode"))%></strong><br><small><%=esc(e.get("course"))%></small></td><td><%=esc(e.get("year"))%></td><td><%=e.get("semester")%></td><td class="actions"><form class="inline-delete" method="post" action="<%=request.getContextPath()%>/enrollments" onsubmit="return confirm('Remove this enrollment?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=e.get("id")%>"><button class="danger-button" type="submit">Remove</button></form></td></tr><%}%>
<%if(enrollments==null||enrollments.isEmpty()){%><tr><td colspan="6" class="empty">No enrollments found. Add an enrollment to connect a student and a course.</td></tr><%}%></tbody></table></div></section><footer>CampusDesk · Enrollment register <span><a href="<%=request.getContextPath()%>/courses">View courses ↗</a></span></footer></main></body></html>
