<%@ page import="java.util.*" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!
private String esc(Object v){if(v==null)return "";return v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#x27;");}
%>
<% List<Map<String,Object>> courses=(List<Map<String,Object>>)request.getAttribute("courses");String q=request.getParameter("q"); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Courses · CampusDesk</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/app.css"></head><body><aside class="sidebar"><a class="brand" href="<%=request.getContextPath()%>/"><span class="brand-icon">C</span><span>CampusDesk<small>STUDENT SYSTEM</small></span></a><nav><a href="<%=request.getContextPath()%>/">▦ &nbsp; Overview</a><a href="<%=request.getContextPath()%>/students">♙ &nbsp; Students</a><a class="active" href="<%=request.getContextPath()%>/courses">▤ &nbsp; Courses</a><a href="<%=request.getContextPath()%>/enrollments">↗ &nbsp; Enrollments</a></nav><div class="side-note"><span class="dot"></span> Database project<small>Java · JDBC · MySQL</small></div></aside><main class="main"><header class="topbar"><div><p class="eyebrow">ACADEMIC CATALOG</p><h1>Courses</h1><p class="muted">Manage course codes, credits, departments and faculty.</p></div><a class="button" href="<%=request.getContextPath()%>/courses?action=add">＋ Add course</a></header>
<%if("saved".equals(request.getParameter("message"))||"deleted".equals(request.getParameter("message"))){%><div class="notice">✓ <%= "deleted".equals(request.getParameter("message"))?"Course deleted successfully.":"Course saved successfully."%></div><%}%>
<section class="table-panel"><div class="table-toolbar"><div><h2>Course catalog</h2><p class="muted"><%=courses==null?0:courses.size()%> course(s) shown</p></div><form class="search" method="get" action="<%=request.getContextPath()%>/courses"><input name="q" value="<%=esc(q)%>" placeholder="Search course or department…"><button class="button" type="submit">Search</button></form></div><div class="table-wrap"><table><thead><tr><th>CODE</th><th>COURSE NAME</th><th>CREDITS</th><th>DEPARTMENT</th><th>FACULTY</th><th>ACTIONS</th></tr></thead><tbody>
<%if(courses!=null)for(Map<String,Object> c:courses){%><tr><td><strong><%=esc(c.get("code"))%></strong></td><td><%=esc(c.get("name"))%></td><td><span class="pill"><%=c.get("credits")%> credits</span></td><td><%=esc(c.get("department")==null?"Unassigned":c.get("department"))%></td><td><%=esc(c.get("faculty")==null?"Unassigned":c.get("faculty"))%></td><td class="actions"><a href="<%=request.getContextPath()%>/courses?action=edit&id=<%=c.get("id")%>">Edit</a><form class="inline-delete" method="post" action="<%=request.getContextPath()%>/courses" onsubmit="return confirm('Delete this course? Existing enrollments and dependent academic records may also be deleted.')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=c.get("id")%>"><button class="danger-button" type="submit">Delete</button></form></td></tr><%}%>
<%if(courses==null||courses.isEmpty()){%><tr><td colspan="6" class="empty">No courses found. Add a course or try another search.</td></tr><%}%></tbody></table></div></section><footer>CampusDesk · Course catalog <span><a href="<%=request.getContextPath()%>/enrollments">Manage enrollments ↗</a></span></footer></main></body></html>
