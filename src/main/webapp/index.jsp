<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%-- Route direct home-page visits through the dashboard servlet so database statistics are loaded. --%>
<% if (request.getAttribute("studentCount") == null || request.getAttribute("departmentCount") == null) { response.sendRedirect(request.getContextPath() + "/dashboard"); return; } %>
<%!
private String esc(Object value) {
  if (value == null) return "";
  return value.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#x27;");
}
%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CampusDesk · Dashboard</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/app.css"></head>
<body><aside class="sidebar"><a class="brand" href="<%=request.getContextPath()%>/"><span class="brand-icon">C</span><span>CampusDesk<small>STUDENT SYSTEM</small></span></a><nav><a class="active" href="<%=request.getContextPath()%>/">▦ &nbsp; Overview</a><a href="<%=request.getContextPath()%>/students">♙ &nbsp; Students</a><a href="#modules">▤ &nbsp; Academic modules</a><a href="<%=request.getContextPath()%>/enrollments">↗ &nbsp; Enrollments</a><a href="<%=request.getContextPath()%>/attendance">◷ &nbsp; Attendance</a><a href="<%=request.getContextPath()%>/assessments">✓ &nbsp; Assessments & marks</a><a href="<%=request.getContextPath()%>/performance">▥ &nbsp; Performance</a></nav><div class="side-note"><span class="dot"></span> Database project <small>Java · JDBC · MySQL</small></div></aside>
<main class="main"><header class="topbar"><div><p class="eyebrow">CAMPUS ADMINISTRATION</p><h1>Dashboard</h1><p class="muted">A clearer view of your academic records.</p></div><a class="button" href="<%=request.getContextPath()%>/students">Manage students <span>↗</span></a></header>
<section class="welcome"><div><p class="eyebrow light">STUDENT INFORMATION SYSTEM</p><h2>Everything organized.<br>One campus at a time.</h2><p>Manage student records and keep essential academic data in one place.</p><a class="button button-light" href="<%=request.getContextPath()%>/students">Open student directory →</a></div><div class="welcome-art"><div class="orb orb-one"></div><div class="orb orb-two"></div><div class="mini-card"><span>ACADEMIC YEAR</span><strong>2026—27</strong><small>Student records workspace</small></div></div></section>
<section class="stats"><article class="stat-card"><div class="stat-top"><span>Total students</span><span class="stat-icon purple">♙</span></div><strong><%=request.getAttribute("studentCount")==null?"—":esc(request.getAttribute("studentCount"))%></strong><small>Records in the database</small></article><article class="stat-card"><div class="stat-top"><span>Departments</span><span class="stat-icon orange">▦</span></div><strong><%=request.getAttribute("departmentCount")==null?"—":esc(request.getAttribute("departmentCount"))%></strong><small>Academic departments</small></article><article class="stat-card"><div class="stat-top"><span>Database status</span><span class="stat-icon green">✓</span></div><strong class="status-text">Connected</strong><small>Live values from MySQL</small></article></section>
<section class="section-head" id="modules"><div><p class="eyebrow">WORKSPACE</p><h2>Academic modules</h2><p class="muted">Your project is structured to grow with your requirements.</p></div></section><section class="module-grid"><a class="module-card" href="<%=request.getContextPath()%>/students"><span class="module-icon purple">♙</span><h3>Student directory</h3><p>Add, find, update and remove student records.</p><span class="module-link">Open directory ↗</span></a><a class="module-card" href="<%=request.getContextPath()%>/courses"><span class="module-icon orange">▤</span><h3>Courses</h3><p>Create and manage course codes, credits, departments and assigned faculty.</p><span class="module-link">Manage courses ↗</span></a><a class="module-card" href="<%=request.getContextPath()%>/enrollments"><span class="module-icon purple">↗</span><h3>Enrollments</h3><p>Register students into courses by academic year and semester.</p><span class="module-link">Manage enrollments ↗</span></a><a class="module-card" href="<%=request.getContextPath()%>/attendance"><span class="module-icon green">◷</span><h3>Attendance</h3><p>Record daily attendance by student, course and date.</p><span class="module-link">Take attendance ↗</span></a><a class="module-card" href="<%=request.getContextPath()%>/assessments"><span class="module-icon orange">✓</span><h3>Assessments & marks</h3><p>Create assessments and enter marks for enrolled students.</p><span class="module-link">Manage assessments ↗</span></a><a class="module-card" href="<%=request.getContextPath()%>/performance"><span class="module-icon purple">▥</span><h3>Performance reports</h3><p>Review marks average and attendance percentage for each student.</p><span class="module-link">View report ↗</span></a></section><footer>CampusDesk · Student Management System <span>Built with Java, JDBC & MySQL</span></footer></main></body></html>