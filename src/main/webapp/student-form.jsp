<%@ page import="java.util.*,edu.college.sms.model.Student,edu.college.sms.model.Department" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!
private String esc(Object v){if(v==null)return "";return v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#x27;");}
%>
<% Student s=(Student)request.getAttribute("student"); boolean editing=s!=null; boolean viewing="view".equals(request.getParameter("action")); List<Department> departments=(List<Department>)request.getAttribute("departments"); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=editing?"Student details":"Add student"%> · CampusDesk</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/app.css"></head><body><aside class="sidebar"><a class="brand" href="<%=request.getContextPath()%>/"><span class="brand-icon">C</span><span>CampusDesk<small>STUDENT SYSTEM</small></span></a><nav><a href="<%=request.getContextPath()%>/">▦ &nbsp; Overview</a><a class="active" href="<%=request.getContextPath()%>/students">♙ &nbsp; Students</a></nav><div class="side-note"><span class="dot"></span> Database project<small>Java · JDBC · MySQL</small></div></aside><main class="main"><header class="topbar"><div><p class="eyebrow">STUDENT DIRECTORY</p><h1><%=viewing?"Student details":editing?"Edit student":"Add student"%></h1><p class="muted">Enter accurate information for this student record.</p></div><a class="button button-secondary" href="<%=request.getContextPath()%>/students">← Back to students</a></header>
<section class="form-panel"><form method="post" action="<%=request.getContextPath()%>/students"><% if(editing){%><input type="hidden" name="studentId" value="<%=s.getStudentId()%>"><%}%><div class="form-section"><h2>Personal information</h2><p class="muted">Basic details and contact information.</p><div class="form-grid"><label>Roll number *<input required name="rollNo" value="<%=editing?esc(s.getRollNo()):""%>" <%=viewing?"readonly":""%>></label><label>Email address *<input required type="email" name="email" value="<%=editing?esc(s.getEmail()):""%>" <%=viewing?"readonly":""%>></label><label>First name *<input required name="firstName" value="<%=editing?esc(s.getFirstName()):""%>" <%=viewing?"readonly":""%>></label><label>Last name *<input required name="lastName" value="<%=editing?esc(s.getLastName()):""%>" <%=viewing?"readonly":""%>></label><label>Phone<input name="phone" value="<%=editing?esc(s.getPhone()):""%>" <%=viewing?"readonly":""%>></label><label>Date of birth<input type="date" name="dateOfBirth" value="<%=editing&&s.getDateOfBirth()!=null?s.getDateOfBirth().toString():""%>" <%=viewing?"readonly":""%>></label><label>Gender<select name="gender" <%=viewing?"disabled":""%>><option value="">Choose…</option><% String gender=editing?s.getGender():""; for(String g:new String[]{"Female","Male","Non-binary","Prefer not to say"}){%><option <%=g.equals(gender)?"selected":""%>><%=g%></option><%}%></select></label><label>Department<select name="departmentId" <%=viewing?"disabled":""%>><option value="">Unassigned</option><% if(departments!=null) for(Department d:departments){ %><option value="<%=d.getDepartmentId()%>" <%=editing&&s.getDepartmentId()==d.getDepartmentId()?"selected":""%>><%=esc(d.getDepartmentName())%> (<%=esc(d.getDepartmentCode())%>)</option><% } %></select></label><label>Semester<select name="semester" <%=viewing?"disabled":""%>><% for(int i=1;i<=12;i++){%><option value="<%=i%>" <%=editing&&s.getSemester()==i?"selected":!editing&&i==1?"selected":""%>><%=i%></option><%}%></select></label><label>Status<select name="status" <%=viewing?"disabled":""%>><% for(String st:new String[]{"ACTIVE","INACTIVE","GRADUATED"}){%><option <%=editing&&st.equals(s.getStatus())?"selected":!editing&&st.equals("ACTIVE")?"selected":""%>><%=st%></option><%}%></select></label></div></div><div class="form-actions"><a class="button button-secondary" href="<%=request.getContextPath()%>/students">Cancel</a><% if(!viewing){%><button class="button" type="submit"><%=editing?"Save changes":"Create student"%> →</button><%}%></div></form></section><footer>CampusDesk · Student Management System</footer></main></body></html>