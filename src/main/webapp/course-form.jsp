<%@ page import="java.util.*" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!
private String esc(Object v){if(v==null)return "";return v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#x27;");}
%>
<% Map<String,Object> course=(Map<String,Object>)request.getAttribute("course");boolean editing=course!=null;List<Map<String,Object>> departments=(List<Map<String,Object>>)request.getAttribute("departments");List<Map<String,Object>> faculty=(List<Map<String,Object>>)request.getAttribute("faculty"); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=editing?"Edit course":"Add course"%> · CampusDesk</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/app.css"></head><body><aside class="sidebar"><a class="brand" href="<%=request.getContextPath()%>/"><span class="brand-icon">C</span><span>CampusDesk<small>STUDENT SYSTEM</small></span></a><nav><a href="<%=request.getContextPath()%>/">▦ &nbsp; Overview</a><a href="<%=request.getContextPath()%>/students">♙ &nbsp; Students</a><a class="active" href="<%=request.getContextPath()%>/courses">▤ &nbsp; Courses</a><a href="<%=request.getContextPath()%>/enrollments">↗ &nbsp; Enrollments</a></nav></aside><main class="main"><header class="topbar"><div><p class="eyebrow">COURSE CATALOG</p><h1><%=editing?"Edit course":"Add course"%></h1><p class="muted">Assign course credits and optional academic ownership.</p></div><a class="button button-secondary" href="<%=request.getContextPath()%>/courses">← Back to courses</a></header><section class="form-panel"><form method="post" action="<%=request.getContextPath()%>/courses"><%if(editing){%><input type="hidden" name="courseId" value="<%=course.get("id")%>"><%}%><div class="form-section"><h2>Course information</h2><p class="muted">Course code must be unique in the database.</p><div class="form-grid"><label>Course code *<input name="courseCode" required maxlength="20" value="<%=editing?esc(course.get("code")):""%>" placeholder="e.g. CS301"></label><label>Course name *<input name="courseName" required maxlength="120" value="<%=editing?esc(course.get("name")):""%>" placeholder="e.g. Database Management Systems"></label><label>Credits *<select name="credits" required><%for(int i=1;i<=10;i++){%><option value="<%=i%>" <%=editing&&((Number)course.get("credits")).intValue()==i?"selected":!editing&&i==3?"selected":""%>><%=i%> credit(s)</option><%}%></select></label><label>Department<select name="departmentId"><option value="">Unassigned</option><%if(departments!=null)for(Map<String,Object>d:departments){%><option value="<%=d.get("id")%>" <%=editing&&Objects.equals(String.valueOf(course.get("departmentId")),String.valueOf(d.get("id")))?"selected":""%>><%=esc(d.get("name"))%> (<%=esc(d.get("code"))%>)</option><%}%></select></label><label>Faculty<select name="facultyId"><option value="">Unassigned</option><%if(faculty!=null)for(Map<String,Object>f:faculty){%><option value="<%=f.get("id")%>" <%=editing&&Objects.equals(String.valueOf(course.get("facultyId")),String.valueOf(f.get("id")))?"selected":""%>><%=esc(f.get("name"))%></option><%}%></select></label></div></div><div class="form-actions"><a class="button button-secondary" href="<%=request.getContextPath()%>/courses">Cancel</a><button class="button" type="submit"><%=editing?"Save changes":"Create course"%> →</button></div></form></section><footer>CampusDesk · Course catalog</footer></main></body></html>
