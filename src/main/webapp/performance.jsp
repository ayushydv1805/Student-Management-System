<%@ page import="java.util.*" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!
private String esc(Object v){if(v==null)return "";return v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#x27;");}
%>
<%List<Map<String,Object>> students=(List<Map<String,Object>>)request.getAttribute("students");String q=request.getParameter("q");%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Performance report · CampusDesk</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/app.css"></head><body><aside class="sidebar"><a class="brand" href="<%=request.getContextPath()%>/"><span class="brand-icon">C</span><span>CampusDesk<small>STUDENT SYSTEM</small></span></a><nav><a href="<%=request.getContextPath()%>/">▦ &nbsp; Overview</a><a href="<%=request.getContextPath()%>/students">♙ &nbsp; Students</a><a href="<%=request.getContextPath()%>/courses">▤ &nbsp; Courses</a><a href="<%=request.getContextPath()%>/enrollments">↗ &nbsp; Enrollments</a><a href="<%=request.getContextPath()%>/attendance">◷ &nbsp; Attendance</a><a href="<%=request.getContextPath()%>/assessments">✓ &nbsp; Assessments & marks</a><a class="active" href="<%=request.getContextPath()%>/performance">▥ &nbsp; Performance</a></nav></aside><main class="main"><header class="topbar"><div><p class="eyebrow">ACADEMIC OVERVIEW</p><h1>Student performance</h1><p class="muted">Combined attendance and assessment summary for each student.</p></div><a class="button button-secondary" href="<%=request.getContextPath()%>/attendance">Attendance register →</a></header><section class="table-panel"><div class="table-toolbar"><div><h2>Performance summary</h2><p class="muted"><%=students==null?0:students.size()%> student(s) shown. Averages use entered marks as a percentage of each assessment's maximum.</p></div><form class="search" method="get" action="<%=request.getContextPath()%>/performance"><input name="q" value="<%=esc(q)%>" placeholder="Search name or roll number"><button class="button" type="submit">Search</button></form></div><div class="table-wrap"><table><thead><tr><th>STUDENT</th><th>ROLL NO.</th><th>COURSES</th><th>ASSESSMENTS</th><th>MARKS ENTERED</th><th>AVG. MARKS %</th><th>ATTENDANCE %</th></tr></thead><tbody><%if(students!=null)for(Map<String,Object>s:students){%><tr><td><strong><%=esc(s.get("student"))%></strong></td><td><%=esc(s.get("roll"))%></td><td><%=s.get("courses")%></td><td><%=s.get("assessments")%></td><td><%=s.get("marksEntered")%></td><td><%=s.get("average")==null?"—":esc(s.get("average"))+"%"%></td><td><%=s.get("attendance")==null?"—":esc(s.get("attendance"))+"%"%></td></tr><%}%><%if(students==null||students.isEmpty()){%><tr><td colspan="7" class="empty">No students found.</td></tr><%}%></tbody></table></div></section><footer>CampusDesk · Student performance report</footer></main></body></html>
