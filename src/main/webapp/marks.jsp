<%@ page import="java.util.*" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!
private String esc(Object v){if(v==null)return "";return v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#x27;");}
%>
<%Map<String,Object> assessment=(Map<String,Object>)request.getAttribute("assessment");List<Map<String,Object>> students=(List<Map<String,Object>>)request.getAttribute("students");%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Enter marks · CampusDesk</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/app.css"></head><body><aside class="sidebar"><a class="brand" href="<%=request.getContextPath()%>/"><span class="brand-icon">C</span><span>CampusDesk<small>STUDENT SYSTEM</small></span></a><nav><a href="<%=request.getContextPath()%>/">▦ &nbsp; Overview</a><a href="<%=request.getContextPath()%>/students">♙ &nbsp; Students</a><a href="<%=request.getContextPath()%>/courses">▤ &nbsp; Courses</a><a href="<%=request.getContextPath()%>/enrollments">↗ &nbsp; Enrollments</a><a href="<%=request.getContextPath()%>/attendance">◷ &nbsp; Attendance</a><a class="active" href="<%=request.getContextPath()%>/assessments">✓ &nbsp; Assessments & marks</a><a href="<%=request.getContextPath()%>/performance">▥ &nbsp; Performance</a></nav></aside><main class="main"><header class="topbar"><div><p class="eyebrow">MARKS ENTRY</p><h1><%=esc(assessment.get("name"))%></h1><p class="muted">Maximum marks: <strong><%=esc(assessment.get("max"))%></strong> · Save each student's marks separately.</p></div><a class="button button-secondary" href="<%=request.getContextPath()%>/assessments">← Assessments</a></header><%if("saved".equals(request.getParameter("message"))){%><div class="notice">✓ Marks saved successfully.</div><%}%><section class="table-panel"><div class="table-toolbar"><div><h2>Enrolled students</h2><p class="muted"><%=students==null?0:students.size()%> student(s) in this course</p></div></div><div class="table-wrap"><table><thead><tr><th>STUDENT</th><th>ROLL NO.</th><th>MARKS / <%=esc(assessment.get("max"))%></th><th>ACTION</th></tr></thead><tbody><%if(students!=null)for(Map<String,Object>s:students){%><tr><td><strong><%=esc(s.get("student"))%></strong></td><td><%=esc(s.get("roll"))%></td><td><form class="inline-delete" method="post" action="<%=request.getContextPath()%>/assessments"><input type="hidden" name="action" value="saveMarks"><input type="hidden" name="assessmentId" value="<%=assessment.get("id")%>"><input type="hidden" name="studentId" value="<%=s.get("studentId")%>"><input name="marks" type="number" min="0" max="<%=esc(assessment.get("max"))%>" step="0.01" required value="<%=s.get("marks")==null?"":esc(s.get("marks"))%>" placeholder="0.00" style="width:130px"></td><td><button class="button" type="submit">Save marks</button></form></td></tr><%}%><%if(students==null||students.isEmpty()){%><tr><td colspan="4" class="empty">No enrolled students are linked to this course. Add enrollments first.</td></tr><%}%></tbody></table></div></section><footer>CampusDesk · Marks entry</footer></main></body></html>
